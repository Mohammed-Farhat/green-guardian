<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================================================================
       GREEN GUARDIAN — SENSORS & BINS
       Contains: LiDAR standoff, LiDAR body, camera, camera optical
                 frame, bin_left (organic), bin_right (non-organic)
       
       TF frames used by drivers:
         laser_link          ← rplidar_ros publishes /scan here
         camera_link         ← camera driver base frame
         camera_optical_link ← image_raw frame_id (Z=forward convention)
       ================================================================ -->

  <!-- ───────────────────────────────────────────────────────────────
       LIDAR STANDOFF (cylinder pillar)
       A single tall cylinder representing all the stacked standoffs.
       Attached to base_link at LiDAR's X/Y position.
       ─────────────────────────────────────────────────────────────── -->
  <link name="lidar_standoff_link">
    <visual>
      <geometry>
        <cylinder radius="${lidar_standoff_r}" length="${lidar_standoff_h}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="lidar_standoff_gold"/>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0000001" ixy="0.0" ixz="0.0"
               iyy="0.0000001" iyz="0.0"
               izz="0.0000001"/>
    </inertial>
  </link>

  <joint name="lidar_standoff_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="lidar_standoff_link"/>
    <origin xyz="${lidar_x} ${lidar_y} ${lidar_standoff_z}" rpy="0 0 0"/>
    <!-- standoff center Z = chassis_top (rel to base_link) + standoff_h/2 -->
    <!-- = 0.033 + 0.0725 = 0.1055 m above base_link -->
  </joint>

  <!-- ───────────────────────────────────────────────────────────────
       LASER LINK (LiDAR body cylinder)
       Sits on top of standoff. The scan plane is at the center of
       this cylinder — rplidar_ros uses this frame_id for /scan.
       ─────────────────────────────────────────────────────────────── -->
  <link name="laser_link">
    <visual>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="lidar_black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <!-- RPLidar A1 weighs ~170g -->
      <mass value="0.17"/>
      <inertia ixx="0.0000600" ixy="0.0" ixz="0.0"
               iyy="0.0000600" iyz="0.0"
               izz="0.0001041"/>
    </inertial>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="lidar_standoff_link"/>
    <child  link="laser_link"/>
    <origin xyz="0 0 ${lidar_z}" rpy="0 0 3.14159"/>
    <!-- LiDAR center Z relative to standoff center -->
    <!-- = standoff_h/2 + lidar_h/2 = 0.0725 + 0.015 = 0.0875 m -->
  </joint>

  <!-- ───────────────────────────────────────────────────────────────
       CAMERA LINK (Logitech C920)
       Box on front face, centered L/R, at 15cm from ground.
       Pitched 20° downward for optimal YOLO ground detection.
       ─────────────────────────────────────────────────────────────── -->
  <link name="camera_link">
    <visual>
      <geometry>
        <!-- size: depth(X) × width(Y) × height(Z) -->
        <box size="${camera_depth} ${camera_width} ${camera_height}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="camera_dark_grey"/>
    </visual>
    <collision>
      <geometry>
        <box size="${camera_depth} ${camera_width} ${camera_height}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.10"/>
      <inertia ixx="0.0000001" ixy="0.0" ixz="0.0"
               iyy="0.0000001" iyz="0.0"
               izz="0.0000001"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="camera_link"/>
    <origin xyz="${camera_x} ${camera_y} ${camera_z}" rpy="0 ${camera_pitch} 0"/>
    <!-- camera_pitch = -20° → nose down, looking at ground ahead -->
  </joint>

  <!-- ───────────────────────────────────────────────────────────────
       CAMERA OPTICAL LINK
       ROS camera convention: Z forward, X right, Y down.
       This is the frame_id used in sensor_msgs/Image headers.
       The rotation transforms from camera_link (X-forward, Z-up)
       to optical (Z-forward, Y-down).
       ─────────────────────────────────────────────────────────────── -->
  <link name="camera_optical_link"/>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child  link="camera_optical_link"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <!-- ───────────────────────────────────────────────────────────────
       BIN LEFT — ORGANIC (green)
       Sticks out from front face, top flush with chassis top.
       ─────────────────────────────────────────────────────────────── -->
  <link name="bin_left_link">
    <visual>
      <geometry>
        <!-- size: depth(X) × width(Y) × height(Z) -->
        <box size="${bin_depth} ${bin_width} ${bin_height}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="bin_green"/>
    </visual>
    <collision>
      <geometry>
        <box size="${bin_depth} ${bin_width} ${bin_height}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="0.0000500" ixy="0.0" ixz="0.0"
               iyy="0.0000500" iyz="0.0"
               izz="0.0000500"/>
    </inertial>
  </link>

  <joint name="bin_left_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="bin_left_link"/>
    <origin xyz="${bin_x} ${bin_y_offset} ${bin_z}" rpy="0 0 0"/>
    <!-- bin_x: front face + bin_depth/2                        -->
    <!-- bin_y_offset: +9.0cm (left side)                       -->
    <!-- bin_z: top aligned with chassis top → center offset down-->
  </joint>

  <!-- ───────────────────────────────────────────────────────────────
       BIN RIGHT — NON-ORGANIC (yellow)
       Mirror of bin_left along Y axis.
       ─────────────────────────────────────────────────────────────── -->
  <link name="bin_right_link">
    <visual>
      <geometry>
        <box size="${bin_depth} ${bin_width} ${bin_height}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="bin_yellow"/>
    </visual>
    <collision>
      <geometry>
        <box size="${bin_depth} ${bin_width} ${bin_height}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="0.0000500" ixy="0.0" ixz="0.0"
               iyy="0.0000500" iyz="0.0"
               izz="0.0000500"/>
    </inertial>
  </link>

  <joint name="bin_right_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="bin_right_link"/>
    <origin xyz="${bin_x} ${-bin_y_offset} ${bin_z}" rpy="0 0 0"/>
    <!-- -bin_y_offset → right side (negative Y) -->
  </joint>

</robot>