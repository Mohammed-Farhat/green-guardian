<?xml version="1.0"?>
<robot name="green_guardian" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================================================================
       GREEN GUARDIAN — TOP-LEVEL URDF
       
       This file only includes the component files in the correct order:
         1. dimensions  — all measurements (must be first)
         2. materials   — RViz colors
         3. base        — chassis + wheels + IMU
         4. sensors     — LiDAR + camera + bins
       
       To preview:
         ros2 launch robot_description display.launch.py
       
       To validate XACRO parsing:
         xacro robot.urdf.xacro
       ================================================================ -->

  <xacro:include filename="$(find robot_description)/urdf/dimensions.xacro"/>
  <xacro:include filename="$(find robot_description)/urdf/materials.xacro"/>
  <xacro:include filename="$(find robot_description)/urdf/base.xacro"/>
  <xacro:include filename="$(find robot_description)/urdf/sensors.xacro"/>

</robot>