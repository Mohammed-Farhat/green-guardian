<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!--
    RGB camera module
    - Creates: camera_link, camera_frame, camera_optical_frame
    - Attaches to: parent (usually base_link)
    - Uses mount variables: camera_x, camera_y, camera_z
  -->
  <xacro:macro name="rgb_camera" params="parent">

    <link name="camera_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.03 0.10 0.03"/>
        </geometry>
        <material name="mat_dark_grey"/>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.03 0.10 0.03"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.10"/>
        <inertia
          ixx="${(1.0/12.0) * 0.10 * (0.10*0.10 + 0.03*0.03)}"
          iyy="${(1.0/12.0) * 0.10 * (0.03*0.03 + 0.03*0.03)}"
          izz="${(1.0/12.0) * 0.10 * (0.03*0.03 + 0.10*0.10)}"
          ixy="0.0" ixz="0.0" iyz="0.0"/>
      </inertial>
    </link>

    <joint name="base_to_camera_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="camera_link"/>
      <origin xyz="${camera_x} ${camera_y} ${camera_z}" rpy="0 0 0"/>
    </joint>

    <!-- Conventional ROS frames -->
    <link name="camera_frame">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.0001"/>
        <inertia ixx="1e-8" iyy="1e-8" izz="1e-8" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>

    <joint name="camera_link_to_frame_joint" type="fixed">
      <parent link="camera_link"/>
      <child link="camera_frame"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <!-- Optical frame (REP-103): Z forward, X right, Y down -->
    <link name="camera_optical_frame">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.0001"/>
        <inertia ixx="1e-8" iyy="1e-8" izz="1e-8" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>

    <joint name="camera_frame_to_optical_joint" type="fixed">
      <parent link="camera_frame"/>
      <child link="camera_optical_frame"/>
      <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
    </joint>

    <!-- Gazebo RGB camera -->
    <gazebo reference="camera_link">
      <disableFixedJointLumping>true</disableFixedJointLumping>
      <sensor type="camera" name="rgb_camera">
        <topic>camera</topic>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <camera>
          <horizontal_fov>1.396</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>50</far>
          </clip>
        </camera>
      </sensor>
    </gazebo>

  </xacro:macro>

</robot>

